# APInex gateway — OpenAI-compatible. Free tier: https://apinex.bond
# Copy this file to .env and paste your key there. Never commit .env.
APINEX_API_KEY=

# Must point at the APInex gateway.
APINEX_BASE_URL=https://api.apinex.bond/v1

# Free models use the "free/" prefix. Do not use paid or subscription-only ids.
APINEX_TEXT_MODEL=free/deepseek-v4.1-flash

# Optional. APInex does not serve /audio/speech on the free tier, so leave this
# empty: renders are silent and scene length is estimated from the narration.
# Set it only if your gateway exposes a TTS model.
APINEX_TTS_MODEL=

# Local Remotion render worker.
RENDER_WORKER_URL=http://127.0.0.1:4321
RENDER_WORKER_PORT=4321
