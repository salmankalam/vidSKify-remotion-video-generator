{
  "name": "vidskify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,worker -c cyan,magenta \"next dev -p 3100\" \"tsx watch worker/index.ts\"",
    "dev:next": "next dev -p 3100",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "compositions": "tsx scripts/compositions.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/player": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.540",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
